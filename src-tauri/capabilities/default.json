{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "commands:allow-ping",
    "commands:allow-recovery-required",
    "notes:allow-list-notes",
    "notes:allow-get-note",
    "notes:allow-create-note",
    "notes:allow-update-note",
    "notes:allow-delete-note",
    "notes:allow-search-notes",
    "notes:allow-rebuild-index",
    "ai:allow-list-providers",
    "ai:allow-enable-provider",
    "ai:allow-test-provider",
    "ai:allow-ai-chat",
    "ai:allow-ai-complete",
    "ai:allow-ai-summarize",
    "ai:allow-rag-search",
    "ai:allow-ai-transcribe",
    "commands_secrets:allow-set-provider-key",
    "commands_secrets:allow-delete-provider-key",
    "commands_secrets:allow-has-provider-key",
    "commands_secrets:allow-provider-key-status",
    "tasks:allow-list-tasks",
    "tasks:allow-create-task",
    "tasks:allow-update-task",
    "tasks:allow-delete-task",
    "srs:allow-generate-cards",
    "srs:allow-save-cards",
    "srs:allow-queue",
    "srs:allow-review",
    "srs:allow-suspend",
    "study:allow-generate-quiz",
    "study:allow-grade-quiz",
    "study:allow-generate-plan",
    "study:allow-save-plan",
    "study:allow-get-plan",
    "fs:default"
  ]
